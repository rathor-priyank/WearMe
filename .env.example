# =============================================================================
# WearMe — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env or real API credentials to version control.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://wearme:wearme@localhost:5434/wearme_dev

# --- Storage ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_BASE_URL=http://localhost:3001
MAX_FILE_SIZE_MB=10
IMAGE_RETENTION_DAYS=7

# --- AI Provider ---
# Supported providers:
#   mock        -> Deterministic local composite overlay for pipeline testing (free, offline)
#   huggingface -> Free real AI virtual try-on via Hugging Face ZeroGPU (yisol/IDM-VTON, non-commercial)
#   fashn-api   -> Commercial production virtual try-on via official FASHN API v1 (https://api.fashn.ai/v1)
AI_PROVIDER=mock
AI_SERVICE_URL=http://localhost:8001

# Total timeout in seconds for submitting and polling a virtual try-on prediction
AI_REQUEST_TIMEOUT_SECONDS=120
AI_TIMEOUT_MS=120000

# --- Option 1: Official FASHN API v1 Settings (used when AI_PROVIDER=fashn-api) ---
# Required when AI_PROVIDER=fashn-api (obtain from https://app.fashn.ai/api)
AI_API_KEY=
# Model: tryon-v1.6 (stable, 1 credit/image, 5-17s) | tryon-max (higher fidelity, 1-5 credits)
FASHN_MODEL_NAME=tryon-v1.6
# Mode for tryon-v1.6: performance | balanced | quality
FASHN_MODE=balanced
# Return base64 directly instead of storing output on FASHN CDN for 72h (recommended for privacy)
FASHN_RETURN_BASE64=true
# Garment photo hint: auto | flat-lay | model
FASHN_GARMENT_PHOTO_TYPE=auto
# Content moderation level: conservative | permissive | none
FASHN_MODERATION_LEVEL=permissive

# --- Option 2: Free Hugging Face Spaces Settings (used when AI_PROVIDER=huggingface) ---
# Optional free token from https://huggingface.co/settings/tokens for higher daily ZeroGPU quota
HF_TOKEN=
HF_SPACE_ID=yisol/IDM-VTON
HF_DENOISE_STEPS=30

# --- API ---
NODE_ENV=development
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- V2 Cloud Storage (not active in V1) ---
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1
