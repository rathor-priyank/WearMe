# =============================================================================
# WearMe AI Service (apps/ai) — Environment Variables
# Copy to apps/ai/.env and fill in values. Never commit real keys.
# =============================================================================

# Provider: mock | huggingface | fashn-api
AI_PROVIDER=mock

# Request + polling timeout in seconds
AI_REQUEST_TIMEOUT_SECONDS=120
AI_TIMEOUT_MS=120000

# Option 1: Official FASHN API v1 parameters (when AI_PROVIDER=fashn-api)
AI_API_KEY=
FASHN_MODEL_NAME=tryon-v1.6
FASHN_MODE=balanced
FASHN_RETURN_BASE64=true
FASHN_GARMENT_PHOTO_TYPE=auto
FASHN_MODERATION_LEVEL=permissive

# Option 2: Free Hugging Face Spaces VTON (when AI_PROVIDER=huggingface)
# Optional free token from https://huggingface.co/settings/tokens
HF_TOKEN=
HF_SPACE_ID=yisol/IDM-VTON
HF_DENOISE_STEPS=30

HOST=0.0.0.0
PORT=8001
